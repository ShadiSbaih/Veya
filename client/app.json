{
  "expo": {
    "name": "Veya",
    "slug": "veya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/veya-icon.png",
    "scheme": "veya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1238",
        "foregroundImage": "./assets/images/veya-foreground.png",
        "monochromeImage": "./assets/images/veya-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shadisb.client"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/veya-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/veya-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B1238",
          "dark": {
            "image": "./assets/images/veya-splash.png",
            "backgroundColor": "#070B24"
          }
        }
      ],
      "expo-video",
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44dec47a-694a-47e5-aee5-36e2a2f413fd"
      }
    }
  }
}
